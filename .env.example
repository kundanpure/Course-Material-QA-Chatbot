
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash


PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=gemini

POSTGRES_HOST=your-neon-hostname.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=your-neon-username
POSTGRES_PASSWORD=your-neon-password
POSTGRES_DB=course_qa

SECRET_KEY=your-secret-key-generate-random-string-here
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== OPTIONAL: Redis (For caching - can run locally) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== OPTIONAL: Qdrant Vector DB (Can use local Docker or cloud) =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ===== OPTIONAL: Neo4j Knowledge Graph =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ===== OPTIONAL: Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== OPTIONAL: S3 Storage =====
S3_BUCKET_NAME=course-materials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# ===== OPTIONAL: Observability =====
LANGSMITH_API_KEY=
